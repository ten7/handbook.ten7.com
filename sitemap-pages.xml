---
layout: null
permalink: /sitemap-pages.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>{{ '/' | absolute_url }}</loc>
  </url>
{%- for item in site.pages %}{% if item.url != '/' %}
  <url>
    <loc>{{ item.url | absolute_url }}</loc>{% if item.date_modified %}
    <lastmod>{{ item.date_modified }}</lastmod>{% endif %}
  </url>{% endif %}{% endfor %}
</urlset>
